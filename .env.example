# ── Supabase (Required) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Application Base URL (Required for QR links and unsubscribes) ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Paystack Payments (Required for paid ticket tiers & subaccounts) ─
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxx
PAYSTACK_PLATFORM_FEE_PERCENT=5

# ── Resend Transactional Email & Webhooks (Required) ───────────
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# ── Cron & Security Secrets (Required for background jobs & search tokens) ──
CRON_SECRET=your-random-cron-secret
EPHEMERAL_TOKEN_SECRET=your-random-hmac-secret

# ── Platform Admin Access (Comma-separated emails) ────────────
ADMIN_EMAILS=admin@yourdomain.com

# ── WhatsApp Meta Cloud API (Optional) ─────────────────────────
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_TEMPLATE_NAME=crenelle_invite

# ── Upstash Redis Rate Limiting (Optional - Multi-Region Production) ─
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Sentry Error Monitoring (Optional) ─────────────────────────
SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxx

# ── AI Features (Gemini - Required for short-answer question summaries in reports) ──
GEMINI_API_KEY=AIza...

