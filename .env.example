# ── Supabase (Required) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Application Base URL (Required for QR links and unsubscribes) ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Resend Transactional Email (Required) ──────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# ── Platform Admin Access (Comma-separated emails) ────────────
ADMIN_EMAILS=admin@yourdomain.com

# ── WhatsApp Meta Cloud API (Optional) ─────────────────────────
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_TEMPLATE_NAME=crenelle_invite

# ── Upstash Redis Rate Limiting (Optional - Multi-Region Production) ─
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Sentry Error Monitoring (Optional) ─────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxx
