# Sentry & Test Environment Variables
#
# Add these to your .env.local (local dev) and your deployment environment (Vercel / Railway etc.)
# Do NOT commit real values to git.

# ── Sentry ────────────────────────────────────────────────────────────────
# Get from: https://sentry.io → Settings → Projects → [your project] → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://REPLACE_ME@o0.ingest.sentry.io/0

# Server-side Sentry DSN (can be the same value as NEXT_PUBLIC_SENTRY_DSN)
SENTRY_DSN=https://REPLACE_ME@o0.ingest.sentry.io/0

# Get from: https://sentry.io → Settings → Organization → General Settings → Slug
SENTRY_ORG=your-org-slug

# Get from: https://sentry.io → Settings → Projects → [your project] → General Settings → Name
SENTRY_PROJECT=crenelle

# Generate at: https://sentry.io/settings/auth-tokens/ (needs project:releases + org:read scopes)
# Required only for source map uploads during production builds — can be left blank for local dev
SENTRY_AUTH_TOKEN=

# ── E2E Tests (Playwright) ────────────────────────────────────────────────
# A dedicated test account in your LOCAL Supabase instance (not prod!)
E2E_TEST_EMAIL=e2e@yourdomain.com
E2E_TEST_PASSWORD=YourTestPassword1!

# The Supabase ID of an existing published OPEN event in your local DB
# Used by public-registration.spec.ts and guests.spec.ts
# e.g. E2E_TEST_EVENT_SLUG=my-summer-gala-a3f7
E2E_TEST_EVENT_SLUG=bitcoin-pizza-day-ijsg

# The Supabase ID of an existing event in your local DB
# Used by guests.spec.ts
# e.g. E2E_TEST_EVENT_ID=d7e2b4c1-...
E2E_TEST_EVENT_ID=
